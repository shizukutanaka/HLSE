{
  "$schema": "https://json-schema.org/draft/2020-12",
  "$id": "hlse_paste_verdict",
  "title": "HLSE Paste Verdict",
  "description": "JSON output of `hlse_core --json paste \"<command>\"` — detects pastejacking and shell-injection lures in clipboard content.",
  "type": "object",
  "required": [
    "kind",
    "hlse_version",
    "score",
    "action",
    "severity",
    "signals",
    "reasons"
  ],
  "properties": {
    "kind": {
      "const": "paste",
      "description": "Discriminator — always 'paste' for this schema."
    },
    "hlse_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "description": "HLSE engine version that produced this verdict."
    },
    "score": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "action": {
      "type": "string",
      "enum": [
        "SAFE",
        "LOG",
        "ALERT",
        "BLOCK",
        "ISOLATE"
      ]
    },
    "severity": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4,
      "description": "0=SAFE 1=LOG 2=ALERT 3=BLOCK 4=ISOLATE. Use severity >= 3 for actionable gates."
    },
    "signals": {
      "type": "integer",
      "minimum": 0,
      "description": "Bitmask of independent paste-threat detectors that fired."
    },
    "blind_spot": {
      "type": "string",
      "description": "What HLSE cannot detect (score 0 only)."
    },
    "signal_count": {
      "type": "integer",
      "minimum": 1,
      "description": "Number of independent detectors that corroborated (score > 0 only)."
    },
    "confidence": {
      "type": "string",
      "description": "Corroboration level: 'single signal', 'corroborated', 'high confidence' (score > 0 only)."
    },
    "pattern": {
      "type": "string",
      "description": "Attack pattern label (score >= 60 only)."
    },
    "pattern_id": {
      "type": "string",
      "description": "Stable SIEM/SOAR routing token for the detected pattern (e.g. 'HLSE-CLICKFIX') (present iff pattern is present)."
    },
    "objective": {
      "type": "string",
      "description": "The attacker's likely objective (score >= 60 only)."
    },
    "verify": {
      "type": "string",
      "description": "Independent check before pasting (score >= 40 — ALERT band and above)."
    },
    "triage": {
      "type": "string",
      "description": "Immediate response if already pasted (score >= 60 only)."
    },
    "cascade_risk": {
      "type": "string",
      "description": "Other credentials and systems at risk (score >= 60 only)."
    },
    "reasons": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Per-detector justifications for the score."
    },
    "exoneration": {
      "type": "string",
      "description": "Potential benign explanation (15 <= score < 60 only)."
    }
  },
  "additionalProperties": false
}
