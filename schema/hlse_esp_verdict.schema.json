{
  "$schema": "https://json-schema.org/draft/2020-12",
  "$id": "hlse_esp_verdict",
  "title": "HLSE ESP Verdict",
  "description": "JSON output of `hlse_core --json esp <path>` — EFI System Partition integrity assessment for UEFI bootkit indicators.",
  "type": "object",
  "required": [
    "kind",
    "hlse_version",
    "score",
    "action",
    "severity",
    "reasons"
  ],
  "properties": {
    "kind": {
      "const": "esp",
      "description": "Discriminator — always 'esp' for this schema."
    },
    "hlse_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "description": "HLSE engine version that produced this verdict. Use this field to identify verdicts that predate a new detector capability and should be re-scanned."
    },
    "score": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "action": {
      "type": "string",
      "enum": [
        "SAFE",
        "LOG",
        "ALERT",
        "BLOCK",
        "ISOLATE"
      ]
    },
    "severity": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4,
      "description": "0=SAFE 1=LOG 2=ALERT 3=BLOCK 4=ISOLATE. Use severity >= 3 for actionable gates."
    },
    "reasons": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Detected bootkit indicators or system state. Empty array for SAFE verdicts."
    },
    "blind_spot": {
      "type": "string",
      "description": "What HLSE cannot detect for ESP analysis (score 0 only)."
    },
    "signal_count": {
      "type": "integer",
      "minimum": 1,
      "description": "Number of independent bootkit indicators detected (score > 0 only)."
    },
    "confidence": {
      "type": "string",
      "description": "Corroboration level: 'single signal', 'corroborated', 'high confidence' (score > 0 only)."
    },
    "pattern": {
      "type": "string",
      "description": "Attack pattern label (score >= 60 only)."
    },
    "pattern_id": {
      "type": "string",
      "const": "HLSE-ESP-BOOTKIT",
      "description": "Stable SIEM/SOAR routing token (present iff pattern is present)."
    },
    "objective": {
      "type": "string",
      "description": "The attacker's likely objective (score >= 60 only)."
    },
    "verify": {
      "type": "string",
      "description": "Independent check before taking action (score >= 60 only)."
    },
    "triage": {
      "type": "string",
      "description": "Immediate response steps (score >= 60 only)."
    },
    "cascade_risk": {
      "type": "string",
      "description": "Other systems at risk (score >= 60 only)."
    }
  },
  "additionalProperties": false
}
